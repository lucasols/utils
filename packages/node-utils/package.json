{
  "name": "@ls-stack/node-utils",
  "description": "Node.js-specific TypeScript utilities",
  "version": "0.2.1",
  "license": "MIT",
  "scripts": {
    "test:ui": "vitest --ui",
    "test": "vitest run",
    "lint": "pnpm oxlint && pnpm fast-lint",
    "oxlint": "oxlint --type-check --deny-warnings --fix src/",
    "fast-lint": "fast-lint src/ --max-warnings 0 --fix",
    "build": "tsdown",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "update-exports": "node ../../scripts/updatePackageExports.ts"
  },
  "files": [
    "dist",
    "docs"
  ],
  "repository": "github:lucasols/utils",
  "homepage": "https://github.com/lucasols/utils/tree/main/packages/node-utils",
  "author": "Lucas Santos",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.mts",
  "exports": {
    ".": "./dist/main.mjs",
    "./runShellCmd": "./dist/runShellCmd.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@ls-stack/fast-lint": "catalog:",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "tsm": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-plugin-missing-exports": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
