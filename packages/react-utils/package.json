{
  "name": "@ls-stack/react-utils",
  "description": "React-specific TypeScript utilities",
  "version": "0.16.3",
  "license": "MIT",
  "scripts": {
    "test:ui": "vitest --ui",
    "test": "vitest run",
    "lint": "pnpm oxlint && pnpm fast-lint",
    "oxlint": "oxlint --type-check --deny-warnings --fix src/",
    "fast-lint": "fast-lint src/ --max-warnings 0 --fix",
    "build": "tsdown",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "update-exports": "node ../../scripts/updatePackageExports.ts"
  },
  "files": [
    "dist",
    "docs"
  ],
  "repository": "github:lucasols/utils",
  "homepage": "https://github.com/lucasols/utils/tree/main/packages/react-utils",
  "author": "Lucas Santos",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.mts",
  "exports": {
    ".": "./dist/main.mjs",
    "./DelayUnmount": "./dist/DelayUnmount.mjs",
    "./jsxUtils": "./dist/jsxUtils.mjs",
    "./useActionFn": "./dist/useActionFn.mjs",
    "./useAnimateMountUnmount": "./dist/useAnimateMountUnmount.mjs",
    "./useArrayToMap": "./dist/useArrayToMap.mjs",
    "./useAsyncResource": "./dist/useAsyncResource.mjs",
    "./useComponentEvents": "./dist/useComponentEvents.mjs",
    "./useConditionalValueUpdate": "./dist/useConditionalValueUpdate.mjs",
    "./useConst": "./dist/useConst.mjs",
    "./useDebouncedCallback": "./dist/useDebouncedCallback.mjs",
    "./useDebouncedControlledValue": "./dist/useDebouncedControlledValue.mjs",
    "./useDebouncedValue": "./dist/useDebouncedValue.mjs",
    "./useDeepMemo": "./dist/useDeepMemo.mjs",
    "./useInfiniteLoading": "./dist/useInfiniteLoading.mjs",
    "./useIsVisible": "./dist/useIsVisible.mjs",
    "./useLatestValue": "./dist/useLatestValue.mjs",
    "./useMeasureSize": "./dist/useMeasureSize.mjs",
    "./useMemoWithPrev": "./dist/useMemoWithPrev.mjs",
    "./useOnChange": "./dist/useOnChange.mjs",
    "./useOnClickOutside": "./dist/useOnClickOutside.mjs",
    "./useOnMount": "./dist/useOnMount.mjs",
    "./useOnUnMount": "./dist/useOnUnMount.mjs",
    "./usePreventMultipleConsecutiveChanges": "./dist/usePreventMultipleConsecutiveChanges.mjs",
    "./usePrevious": "./dist/usePrevious.mjs",
    "./useRenderMemoizer": "./dist/useRenderMemoizer.mjs",
    "./useScheduleToNextRender": "./dist/useScheduleToNextRender.mjs",
    "./useSet": "./dist/useSet.mjs",
    "./useShortCut": "./dist/useShortCut.mjs",
    "./useTimeout": "./dist/useTimeout.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0||^19.0.0"
  },
  "devDependencies": {
    "@ls-stack/fast-lint": "catalog:",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "catalog:",
    "happy-dom": "^18.0.1",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "catalog:",
    "tsm": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-plugin-missing-exports": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@evtmitter/react": "^0.1.2",
    "@ls-stack/browser-utils": "workspace:^",
    "@ls-stack/utils": "workspace:^",
    "evtmitter": "catalog:",
    "t-result": "catalog:"
  }
}
