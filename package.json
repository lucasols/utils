{
  "name": "@ls-stack/utils-monorepo",
  "private": true,
  "description": "Monorepo for @ls-stack TypeScript utilities",
  "version": "3.18.0",
  "license": "MIT",
  "scripts": {
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "update-exports": "pnpm -r update-exports",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:utils": "pnpm --filter @ls-stack/utils build",
    "build:node-utils": "pnpm --filter @ls-stack/node-utils build",
    "build:browser-utils": "pnpm --filter @ls-stack/browser-utils build",
    "docs": "pnpm -r run docs",
    "docs:utils": "pnpm --filter @ls-stack/utils docs",
    "docs:node-utils": "pnpm --filter @ls-stack/node-utils docs",
    "docs:browser-utils": "pnpm --filter @ls-stack/browser-utils docs",
    "docs:react-utils": "pnpm --filter @ls-stack/react-utils docs",
    "docs:typedoc": "pnpm docs:utils && pnpm docs:node-utils && pnpm docs:browser-utils && pnpm docs:react-utils",
    "docs:watch": "pnpm -r --parallel docs:watch",
    "build-lint-test-all": "pnpm build && pnpm lint && pnpm test",
    "publish-package": "pkg-manager publish",
    "sync-ai": "node ./scripts/syncAi.ts",
    "docs:vitepress:dev": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": "github:lucasols/utils",
  "author": "Lucas Santos",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@ls-stack/fast-lint": "catalog:",
    "@ls-stack/pkg-manager": "^0.12.0",
    "@types/node": "catalog:",
    "@vitest/ui": "catalog:",
    "dequal": "catalog:",
    "immer": "^10.1.1",
    "jiti": "^2.5.1",
    "mitata": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsdown": "catalog:",
    "tsm": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-plugin-missing-exports": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress": "2.0.0-alpha.12",
    "vitepress-plugin-llmstxt": "^0.4.2",
    "vitest": "catalog:"
  }
}
