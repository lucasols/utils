{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2023",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "stripInternal": true,
    "allowImportingTsExtensions": true
  }
}
